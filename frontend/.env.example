# Copy this file to .env and adjust for your environment.

# Base URL of the Express API (backend/index.js listens on 5000 by default).
# Change this per branch / deployment target.
VITE_API_URL=http://localhost:5000

# Auth mode.
#   dev  - validates credentials against the local role table in src/auth/devUsers.js.
#          Use this until POST /api/auth/login exists on the backend.
#   api  - posts credentials to `${VITE_API_URL}/api/auth/login`.
VITE_AUTH_MODE=dev
